{
  "name": "de-compromise",
  "version": "0.1.1",
  "description": "Computerlinguistik im browser",
  "license": "MIT",
  "repository": "github:nlp-compromise/de-compromise",
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./builds/de-compromise.mjs"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./builds/de-compromise.cjs"
      }
    }
  },
  "main": "./builds/de-compromise.mjs",
  "browser": "./builds/de-compromise.min.js",
  "types": "./types/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=12"
  },
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "test": "pnpm run check-package-types && pnpm run check-types && tape \"./tests/**/*.test.js\" | tap-dancer",
    "check-types": "tsc -p tsconfig.json",
    "testb": "cross-env TESTENV=prod pnpm run test",
    "build": "pnpm run version && rollup -c --silent",
    "prepack": "pnpm run build && pnpm run testb && pnpm run lint",
    "version": "node ./scripts/version.js",
    "pack": "node ./scripts/pack.js",
    "score": " node ./learn/test/index.js",
    "lint": "eslint ./src/**/*",
    "watch": "node --watch ./scratch.js",
    "stress": "node scripts/stress.js",
    "match": "node scripts/match.js",
    "check-package-types": "tsc -p tests/package-types/tsconfig.json"
  },
  "files": [
    "builds/",
    "src/",
    "types/"
  ],
  "dependencies": {
    "compromise": "^14.19.0",
    "efrt": "2.9.0",
    "rollup-plugin-filesize-check": "^2.0.1",
    "suffix-thumb": "6.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.2",
    "cross-env": "10.1.0",
    "de-corpus": "0.0.1",
    "eslint": "10.14.0",
    "eslint-plugin-regexp": "3.3.3",
    "globals": "17.14.0",
    "rollup": "4.67.4",
    "tap-dancer": "0.4.4",
    "tape": "5.10.3",
    "typescript": "7.0.2"
  },
  "unpkg": "./builds/de-compromise.min.js",
  "prettier": {
    "trailingComma": "none",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "printWidth": 100
  }
}
